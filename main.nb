Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "settlingTimeAtPointFast", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"settlingTimeAtPointFast", "[", 
    RowBox[{
     RowBox[{"kpValue_", "?", "NumericQ"}], ",", 
     RowBox[{"kiValue_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Aloc", ",", "hloc", ",", "Xloc", ",", "xloc", ",", "phiMExpr", ",", 
       "timeGrid", ",", "vals", ",", "outside"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Aloc", "=", 
       RowBox[{"A", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"kp", "->", "kpValue"}], ",", 
          RowBox[{"ki", "->", "kiValue"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hloc", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", 
         RowBox[{"{", "0", "}"}], ",", 
         RowBox[{"{", "0", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", "*", "kiValue"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Xloc", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Inverse", "[", "Aloc", "]"}], ".", "hloc"}], "*", 
        RowBox[{"Pi", "/", "p"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xloc", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"InverseLaplaceTransform", "[", 
         RowBox[{"Xloc", ",", "p", ",", "t"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"phiMExpr", "=", 
       RowBox[{"xloc", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"timeGrid", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "40", ",", "0.01"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vals", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"phiMExpr", "/.", " ", 
           RowBox[{"t", "->", "#"}]}], "]"}], "&"}], "/@", "timeGrid"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"outside", "=", 
       RowBox[{"Pick", "[", 
        RowBox[{"timeGrid", ",", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"vals", "-", "Pi"}], "]"}], ">", 
          RowBox[{"0.1", "*", "Pi"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"outside", "===", 
         RowBox[{"{", "}"}]}], ",", "0", ",", 
        RowBox[{"Min", "[", 
         RowBox[{"40", ",", 
          RowBox[{
           RowBox[{"Last", "[", "outside", "]"}], "+", "0.01"}]}], "]"}]}], 
       "]"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "dataSettling", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dataSettling", "=", 
