Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tpRegionPlot", "=", 
     RowBox[{"ListDensityPlot", "[", 
      RowBox[{"dataSettling", ",", 
       RowBox[{"InterpolationOrder", "->", "1"}], ",", 
       RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<k\:043f\>\"", ",", "\"\<k\:0438\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"BarLegend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<Rainbow\>\"", ",", 
              RowBox[{"MinMax", "[", 
               RowBox[{"dataSettling", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"LegendLabel", "->", "\"\<t\:043f, c\>\""}]}], "]"}], ",",
           "Right"}], "]"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "18"}], "]"}]}], ",", 
       RowBox[{"BaseStyle", "->", 
        RowBox[{"{", 
         RowBox[{"FontSize", "->", "16"}], "}"}]}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"GridLinesStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"GrayLevel", "[", "0.85", "]"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "tpRegionPlot", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tpContourPlot", "=", 
     RowBox[{"ListContourPlot", "[", 
      RowBox[{"dataSettling", ",", 
       RowBox[{"InterpolationOrder", "->", "1"}], ",", 
       RowBox[{"Contours", "->", "10"}], ",", 
       RowBox[{"ContourLabels", "->", "True"}], ",", 
       RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<k\:043f\>\"", ",", "\"\<k\:0438\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"BarLegend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<Rainbow\>\"", ",", 
              RowBox[{"MinMax", "[", 
               RowBox[{"dataSettling", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"LegendLabel", "->", "\"\<t\:043f, c\>\""}]}], "]"}], ",",
           "Right"}], "]"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "18"}], "]"}]}], ",", 
