            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"xloc", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "t"}], "]"}]}], ")"}]}], "+", 
         RowBox[{"c", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"xloc", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"xloc", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"values", "=", 
