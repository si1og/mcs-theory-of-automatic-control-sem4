946a0d14624b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"buildTransientPlots", "[", 
    RowBox[{"kpValue_", ",", "kiValue_", ",", "name_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"X", ",", "x", ",", "g1", ",", "g2", ",", "g3", ",", "g4"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"kp", "=", "kpValue"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ki", "=", "kiValue"}], ";", "\[IndentingNewLine]", 
      RowBox[{"h", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", 
         RowBox[{"{", "0", "}"}], ",", 
         RowBox[{"{", "0", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", "*", "ki"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"X", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Inverse", "[", "A", "]"}], ".", "h"}], "*", 
         RowBox[{"Pi", "/", "p"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"InverseLaplaceTransform", "[", 
         RowBox[{"X", ",", "p", ",", "t"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"g1", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"PlotStyle", "->", "Red"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<t\>\"", ",", "\"\<\[Phi]\:0440\:043f\:0440(t)\>\""}], 
           "}"}]}], ",", 
         RowBox[{"ImageSize", "->", "Large"}], ",", 
         RowBox[{"LabelStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Black", ",", "14"}], "]"}]}], ",", 
         RowBox[{"BaseStyle", "->", 
          RowBox[{"{", 
           RowBox[{"FontSize", "->", "14"}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"g2", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", 
