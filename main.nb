      RowBox[{
       RowBox[{"Aloc", "=", 
        RowBox[{"A", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"kp", "->", "kpValue"}], ",", 
           RowBox[{"ki", "->", "kiValue"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"hloc", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "0", "}"}], ",", 
          RowBox[{"{", "0", "}"}], ",", 
          RowBox[{"{", "0", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", "*", "kiValue"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Xloc", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Inverse", "[", "Aloc", "]"}], ".", "hloc"}], "*", 
         RowBox[{"Pi", "/", "p"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xloc", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"InverseLaplaceTransform", "[", 
          RowBox[{"Xloc", ",", "p", ",", "t"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"MmExpr", "=", 
        RowBox[{
         RowBox[{"b", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"xloc", "[", 
