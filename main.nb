Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "settlingTimeAtPointFast", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"settlingTimeAtPointFast", "[", 
     RowBox[{
      RowBox[{"kpValue_", "?", "NumericQ"}], ",", 
      RowBox[{"kiValue_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "Aloc", ",", "hloc", ",", "Xloc", ",", "xloc", ",", "phiExpr", ",", 
        "dt", ",", "timeGrid", ",", "vals", ",", "insideQ", ",", "tpIndex"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"dt", "=", "0.05"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Aloc", "=", 
        RowBox[{"A", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"kp", "->", "kpValue"}], ",", 
           RowBox[{"ki", "->", "kiValue"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"hloc", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "0", "}"}], ",", 
          RowBox[{"{", "0", "}"}], ",", 
          RowBox[{"{", "0", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", "*", "kiValue"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Xloc", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Inverse", "[", "Aloc", "]"}], ".", "hloc"}], "*", 
         RowBox[{"Pi", "/", "p"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xloc", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"InverseLaplaceTransform", "[", 
          RowBox[{"Xloc", ",", "p", ",", "tau"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"phiExpr", "=", 
        RowBox[{"xloc", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"timeGrid", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "40", ",", "dt"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"N", "[", 
            RowBox[{"phiExpr", "/.", " ", 
             RowBox[{"tau", "->", "tt"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"tt", ",", "timeGrid"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"insideQ", "[", "v_", "]"}], ":=", 
        RowBox[{
         RowBox[{"0.9", " ", "Pi"}], "<=", "v", "<=", 
         RowBox[{"1.1", " ", "Pi"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tpIndex", "=", 
        RowBox[{"FirstPosition", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"And", "@@", 
             RowBox[{"(", 
              RowBox[{"insideQ", "/@", 
               RowBox[{"vals", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ";;"}], "]"}], "]"}]}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"Length", "[", "vals", "]"}]}], "}"}]}], "]"}], ",", 
          "True"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"tpIndex", "===", 
          RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", "40", ",", 
         RowBox[{"timeGrid", "[", 
          RowBox[{"[", 
           RowBox[{"tpIndex", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "]"}]}]}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "\:0421\:0447\:0438\:0442\:0430\:0435\:043c", " ", 
     "\:0434\:043b\:0438\:0442\:0435\:043b\:044c\:043d\:043e\:0441\:0442\:044c\
", " ", "\:0442\:043e\:043b\:044c\:043a\:043e", " ", "\:0432", " ", 
     "\:0438\:0442\:043e\:0433\:043e\:0432\:043e\:0439", " ", 
     "\:0434\:043e\:043f\:0443\:0441\:0442\:0438\:043c\:043e\:0439", " ", 
     "\:043e\:0431\:043b\:0430\:0441\:0442\:0438"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"allowedBothCoarse", "=", 
     RowBox[{"allowedBoth", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", " ", ";;", "10"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataSettling", "=", 
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"settlingTimeAtPointFast", "[", 
           RowBox[{
            RowBox[{"#", "[", 
