Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"R", "[", "w_", "]"}], ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ReW", "[", "w", "]"}], "^", "2"}], "+", 
      RowBox[{
       RowBox[{"ImW", "[", "w", "]"}], "^", "2"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"min", "=", 
   RowBox[{"NMinimize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"R", "[", "w", "]"}], ",", 
       RowBox[{"w", ">", "0"}]}], "}"}], ",", "w"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"wMin", "=", 
   RowBox[{"w", "/.", " ", 
    RowBox[{"min", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RMin", "=", 
    RowBox[{"min", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stabilityMarginPlot", "=", 
    RowBox[{"ParametricPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ReW", "[", "w", "]"}], ",", 
        RowBox[{"ImW", "[", "w", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"w", ",", "0.01", ",", "10"}], "}"}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Re(\[Omega])\>\"", ",", "\"\<Im(\[Omega])\>\""}], 
        "}"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "5"}], "*", 
            RowBox[{"10", "^", "7"}]}], ",", 
           RowBox[{"6", "*", 
            RowBox[{"10", "^", "7"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "*", 
            RowBox[{"10", "^", "7"}]}], ",", 
           RowBox[{"4", "*", 
            RowBox[{"10", "^", "7"}]}]}], "}"}]}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", "Thick"}], ",", 
      RowBox[{"ImageSize", "->", "Large"}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "14"}], "]"}]}], ",", 
      RowBox[{"BaseStyle", "->", 
       RowBox[{"{", 
        RowBox[{"FontSize", "->", "14"}], "}"}]}], ",", 
      RowBox[{"Epilog", "->", 
       RowBox[{"{", 
        RowBox[{"Red", ",", 
         RowBox[{"PointSize", "[", "Large", "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ReW", "[", "wMin", "]"}], ",", 
            RowBox[{"ImW", "[", "wMin", "]"}]}], "}"}], "]"}], ",", "Dashed", 
         ",", 
