 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"maxMomentAtPointFast", "[", 
     RowBox[{
      RowBox[{"kpValue_", "?", "NumericQ"}], ",", 
      RowBox[{"kiValue_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "Aloc", ",", "hloc", ",", "Xloc", ",", "xloc", ",", "MmExpr", ",", 
